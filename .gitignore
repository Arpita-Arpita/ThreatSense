# ─────────────────────────────────────────────────────────────
# Secrets  — NEVER commit real env files or keys.
# .env.example is the only env file that is tracked.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
service-account*.json

# ─────────────────────────────────────────────────────────────
# Python (backend + ml)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# Node / React (frontend)
# ─────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# ML artifacts & datasets  (large, regenerable from train.py)
# ─────────────────────────────────────────────────────────────
ml/data/raw/
ml/data/processed/
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.json
!ml/models/.gitkeep

# ─────────────────────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# ─────────────────────────────────────────────────────────────
# Editors / IDE
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ─────────────────────────────────────────────────────────────
# Runtime / logs / local data
# ─────────────────────────────────────────────────────────────
*.log
logs/
*.sqlite3
pgdata/

# Optional: keep your capstone evidence local rather than in git.
# Comment the next line out if you DO want screenshots tracked.
# evidence/
backend/var/
