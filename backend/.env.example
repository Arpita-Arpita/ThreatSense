# ─────────────────────────────────────────────────────────────
# Backend env  (FastAPI).  Copy to backend/.env and fill in.
# Loaded via Pydantic settings in app/config.py (task 1.3).
# NEVER commit the filled-in .env — only this .example is tracked.
# ─────────────────────────────────────────────────────────────

# --- Database (match the root / compose Postgres creds) ---
DATABASE_URL=postgresql+psycopg://threatsense:change_me_local_dev@localhost:5432/threatsense

# --- Auth / JWT (tasks 1.4, 1.5) ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_value
JWT_EXPIRY_MINUTES=60
BCRYPT_COST_FACTOR=12
# Local dev is HTTP, so Secure cookies won't set. Toggle this for the
# dev override discussed in [DECISION] 1.4. Set true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- CORS (React dev server) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Syslog ingestion (task 1.6) ---
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=1514
SYSLOG_FLUSH_SECONDS=5
SYSLOG_FLUSH_BATCH=500

# --- ML model (loaded by backend from the ml/ package, task 1.12) ---
MODEL_VERSION=IF_v1.0
MODEL_DIR=../ml/models

# --- SendGrid (Phase 2, task 2.3) — key restricted to Mail Send ---
# Leave SENDGRID_API_KEY empty to run on the mock sender: alerts are logged and
# alerts rows are written, but no email leaves the machine. Fill it in after
# task 2.2 (account + Single Sender Verification) for live delivery.
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=verified-sender@example.com
ALERT_FROM_NAME=ThreatSense
# auto = SendGrid when a key is present, otherwise mock. Force with mock|sendgrid.
ALERT_EMAIL_SENDER=auto

# --- Alert worker (Phase 2, task 2.3) ---
# NFR-09 wants the first dispatch attempt within 10s of a detection.
ALERT_POLL_SECONDS=5
ALERT_BATCH_SIZE=200
ALERT_DEDUP_MINUTES=5
ALERT_RETRY_BACKOFF=2,4,8
ALERT_WORKER_STATE_PATH=var/alert_worker_state.json
# First run only: 0 starts from now, so start the worker BEFORE generating
# traffic. Raise it (e.g. 60) to pick up detections already in the table.
ALERT_INITIAL_LOOKBACK_MINUTES=0
# false = notify the admin who owns the source (Phase 1 ownership model).
# true  = notify every admin with email enabled (literal Algorithm 3).
ALERT_FANOUT_ALL_ADMINS=false
# quiet_start/quiet_end are bare TIME values. Containers usually run UTC, so set
# this if quiet hours must match local working hours.
ALERT_QUIET_HOURS_TZ=Australia/Sydney
# Link target in the alert email button.
DASHBOARD_URL=http://localhost:5173

# --- OpenAI incident reports (Phase 3, task 3.2) — set a hard billing cap! ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15

# --- App ---
ENV=development
LOG_LEVEL=info

# --- Incident reports client selection (Phase 3, task 3.2) ---
# auto = OpenAI when OPENAI_API_KEY is set, otherwise mock (offline dev/tests)
REPORT_LLM_CLIENT=auto
REPORT_MAX_COMPLETION_TOKENS=1200
REPORT_RATE_LIMIT=10
REPORT_RATE_WINDOW_MINUTES=60
