# ──────────────────────────────────────────────────────────────
# Frontend env  (React 18 + Vite).  Copy to frontend/.env
# Only VITE_-prefixed vars are exposed to the browser bundle,
# so NEVER put secrets (API keys) here — those stay in the backend.
# ──────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend. The API client sends the
# HttpOnly session cookie with credentials:"include" (task 1.15).
VITE_API_BASE_URL=http://localhost:8000

# Dashboard polling interval in ms (MVP polling, Sec 2.4 / task 1.16).
VITE_DASHBOARD_POLL_MS=30000
